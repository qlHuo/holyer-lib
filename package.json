{
  "name": "holyer-lib",
  "version": "1.0.0",
  "private": true,
  "description": "A component library for Vue2",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm run -r build",
    "build:all": "pnpm run build:utils && pnpm run build:ui",
    "build:ui": "node scripts/build-ui.js",
    "build:utils": "node scripts/build-utils.js",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish",
    "prepare": "husky",
    "lint": "eslint packages --ext .js,.vue",
    "lint:fix": "eslint packages --ext .js,.vue --fix",
    "docs:dev": "pnpm build:all && vuepress dev docs",
    "docs:build": "pnpm build:all && vuepress build docs"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.12.16",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.29.8",
    "@rollup/plugin-commonjs": "^21.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.0.3",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "less-loader": "4.1.0",
    "prettier": "^2.4.1",
    "rollup": "^2.79.2",
    "rollup-plugin-less": "^1.1.3",
    "rollup-plugin-postcss": "~4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^5.1.9",
    "vue": "2.6.14",
    "vue-template-compiler": "2.6.14",
    "vuepress": "1.8.2",
    "vuepress-plugin-demo-container": "0.2.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "pnpm": ">=7.0.0"
  },
  "pnpm": {
    "overrides": {
      "loader-utils@<1.4.1": "^1.4.1",
      "json5@<1.0.2": "^1.0.2",
      "postcss": "7.0.36",
      "autoprefixer": "9.8.8",
      "rollup@<2.79.2": "^2.79.2",
      "html-entities": "1.4.0",
      "less": "4.5.1",
      "less-loader": "4.1.0",
      "vue-server-renderer": "2.6.14",
      "@vuepress/core>vue": "2.6.14",
      "@vuepress/core>vue-server-renderer": "2.6.14",
      "webpack": "4.47.0"
    }
  }
}
