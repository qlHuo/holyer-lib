{
  "name": "holyer-lib",
  "version": "1.0.0",
  "private": true,
  "description": "A component library for Vue2",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm run -r build",
    "build:all": "pnpm run build:utils && pnpm run build:ui",
    "build:ui": "node scripts/build-ui.js",
    "build:utils": "node scripts/build-utils.js",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish",
    "prepare": "husky",
    "lint": "eslint packages --ext .js,.vue",
    "lint:fix": "eslint packages --ext .js,.vue --fix",
    "docs:dev": "pnpm build:all && pnpm --filter docs dev",
    "docs:build": "pnpm build:all && pnpm --filter docs build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/preset-env": "^7.29.2",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.29.8",
    "@rollup/plugin-commonjs": "^21.1.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^27.0.0",
    "babel-jest": "^27.5.1",
    "core-js": "^3.49.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^8.0.3",
    "husky": "^9.1.7",
    "jest": "^27.5.1",
    "jest-environment-jsdom": "^27.5.1",
    "jsdom": "^16.7.0",
    "less": "^4.5.1",
    "less-loader": "4.1.0",
    "prettier": "^2.4.1",
    "rollup": "^2.79.2",
    "rollup-plugin-less": "^1.1.3",
    "rollup-plugin-postcss": "~4.0.2",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^5.1.9",
    "vue": "2.6.14",
    "vue-template-compiler": "2.6.14"
  },
  "engines": {
    "node": ">=14.0.0",
    "pnpm": ">=7.0.0"
  },
  "pnpm": {
    "overrides": {
      "loader-utils@<1.4.1": "^1.4.1",
      "json5@<1.0.2": "^1.0.2",
      "rollup@<2.79.2": "^2.79.2",
      "html-entities": "1.4.0"
    }
  }
}
